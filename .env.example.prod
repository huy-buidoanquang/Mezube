# Prod Mezon — copy to .env.prod and fill secrets
MEZON_BOT_ID=your_bot_id
MEZON_BOT_TOKEN=your_bot_secret
MEZON_SERVER_KEY=HTTP3m3zonPr0dkey
MEZON_HOST=gw.mezon.ai
MEZON_PORT=443
MEZON_USE_SSL=true
MEZUBE_COMMAND_PREFIX=!
# Leave empty → auto https://stn.mezon.ai, or use local media-station:
# MEZUBE_STN_BASE_URL=https://stn.mezon.ai
# MEZUBE_CDN_BASE_URL=https://cdn.komu.vn
# MEZUBE_BOT_AVATAR_URL=https://cdn.example/bot-avatar.gif
# MEZUBE_DEFAULT_CLAN_ID=
# MEZUBE_DEFAULT_STREAM_CHANNEL_ID=
# MEZUBE_TRACKS_DB_PATH=data/tracks.db
# MEZUBE_YTDLP_PATH=yt-dlp
# MEZUBE_FFMPEG_PATH=ffmpeg
