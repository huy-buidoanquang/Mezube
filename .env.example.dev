# Dev Mezon — copy to .env.dev and fill secrets
MEZON_BOT_ID=your_bot_id
MEZON_BOT_TOKEN=your_bot_secret
MEZON_SERVER_KEY=defaultkey
MEZON_HOST=dev-mezon.nccsoft.vn
MEZON_PORT=8088
MEZON_USE_SSL=true
MEZUBE_COMMAND_PREFIX=!
